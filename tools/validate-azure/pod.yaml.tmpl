apiVersion: v1
kind: Pod
metadata:
  name: ${VERIFY_POD_NAME}
  namespace: ate-system
  labels:
    azure.workload.identity/use: "true"
    app: substrate-azure-validation
spec:
  serviceAccountName: ${VERIFY_SERVICE_ACCOUNT}
  restartPolicy: Never
  containers:
  - name: verify
    image: ${VERIFY_IMAGE}
    args: ["--mode=${VERIFY_MODE}"]
    env:
    - name: ATE_AZURE_STORAGE_ENDPOINT
      value: https://menxiaosubstrate1005.blob.core.windows.net/
    - name: ATE_AZURE_STORAGE_CONTAINER
      value: actor-state
    - name: ATE_API_POSTGRES_READ_WRITE_CONNECTION_STRING
      value: host=menxiao-substrate-1005-pg.postgres.database.azure.com port=5432 dbname=substrate user=menxiao-substrate-1005-postgres sslmode=verify-full
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: "1"
        memory: 256Mi
