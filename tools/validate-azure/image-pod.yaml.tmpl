apiVersion: v1
kind: Pod
metadata:
  name: ${VERIFY_POD_NAME}
  namespace: ate-system
  labels:
    azure.workload.identity/use: "true"
    app: substrate-azure-validation
spec:
  serviceAccountName: substrate-acr
  nodeName: ${NODE_NAME}
  restartPolicy: Never
  containers:
  - name: verify
    image: ${VERIFY_IMAGE}
    args: ["--mode=image", "--image=${DATA_AGENT_IMAGE}"]
    env:
    - name: ATE_AZURE_ACR_ENDPOINT
      value: https://menxiaosubstrate1005.azurecr.io
    - name: NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
    volumeMounts:
    - name: image-cache
      mountPath: /var/lib/ate/image-cache
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: "1"
        memory: 512Mi
  volumes:
  - name: image-cache
    hostPath:
      path: /var/lib/ate/image-cache
      type: DirectoryOrCreate
