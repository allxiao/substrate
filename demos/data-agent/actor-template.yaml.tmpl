metadata:
  atespace: ate-demo-data-agent
  name: data-agent
coldStart: true
homeDirectory: /home/agent
workerSelector:
  matchLabels:
    workload: data-agent
containers:
- name: agent
  image: ${DATA_AGENT_IMAGE}
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 8080
    timeoutSeconds: 120
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_DATA
  onCommit: SNAPSHOT_CONTENT_SCOPE_DATA
  storageLocation: azblob://actor-state/data-agent
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_MICROVM
  configName: microvm
